# .env.example

# AI Provider Configuration (Options: 'gemini', 'groq', 'openrouter', 'ollama', 'custom')
VITE_AI_PROVIDER=gemini

# Default Model Selection (e.g., 'gemini-2.5-flash', 'llama-3.3-70b-versatile', 'qwen2.5', 'deepseek-r1-distill-llama-70b')
VITE_AI_MODEL=gemini-2.5-flash

# Custom Base URL for OpenAI-compatible APIs (e.g., 'https://api.groq.com/openai/v1', 'http://localhost:11434/v1')
VITE_AI_BASE_URL=

# Primary API Key (Gemini, Groq, OpenRouter, or OpenAI-compatible key)
API_KEY=
